---
import "../styles/index.css";

type SeoType = "website" | "article";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: SeoType;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  image = "/images/hero/hero-bg.jpg",
  type = "website",
  noindex = false,
  bodyClass = "",
} = Astro.props;

const siteName = "Plenitud Emocional";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const robots = noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Favicon: SVG primary, with generic fallback -->
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a2e1a" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script src="/js/scroll-reveal.js" defer></script>
  </body>
</html>
