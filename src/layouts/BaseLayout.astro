---
import "../styles/index.css";

type SeoType = "website" | "article";

interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  type?: SeoType;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  keywords = "plenitud emocional, plenitudemocional, plenitudemocional.com, psicologia adultos mayores, abogados adultos mayores",
  image = "/images/hero/hero-bg.jpg",
  type = "website",
  noindex = false,
  bodyClass = "",
} = Astro.props;

const siteName = "Plenitud Emocional";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const robots = noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large";

const isArticle = type === "article";
const isLegalPage = Astro.url.pathname.includes("/abogados");
const isPsychologyPage = Astro.url.pathname.includes("/psicologia");

let schema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Plenitud Emocional",
  "url": "https://plenitudemocional.com",
  "logo": "https://plenitudemocional.com/logo.svg",
  "description": "Acompañamiento psicológico y orientación legal para personas adultas mayores y sus familias."
};

if (isArticle) {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": ogImage,
    "url": canonicalUrl || `https://plenitudemocional.com${Astro.url.pathname}`,
    "publisher": {
      "@type": "Organization",
      "name": "Plenitud Emocional",
      "logo": {
        "@type": "ImageObject",
        "url": "https://plenitudemocional.com/logo.svg"
      }
    }
  };
} else if (isLegalPage) {
  schema = {
    "@context": "https://schema.org",
    "@type": "LegalService",
    "name": "Espinoza Mosqueda Abogadas | Plenitud Emocional",
    "url": "https://plenitudemocional.com/abogados",
    "logo": "https://plenitudemocional.com/logo.svg",
    "image": "https://plenitudemocional.com/images/hero/hero-abogados.jpg",
    "description": description,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Morelia",
      "addressRegion": "Michoacán",
      "addressCountry": "MX"
    },
    "telephone": "+524431399471"
  };
} else if (isPsychologyPage) {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Psicología Catalina Gallegos | Plenitud Emocional",
    "url": "https://plenitudemocional.com/psicologia",
    "logo": "https://plenitudemocional.com/logo.svg",
    "image": "https://plenitudemocional.com/images/hero/hero-bg.jpg",
    "description": description,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Morelia",
      "addressRegion": "Michoacán",
      "addressCountry": "MX"
    },
    "telephone": "+524431399471"
  };
}
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Favicon: SVG primary, with generic fallback -->
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a2e1a" />

    <!-- Google Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class={bodyClass}>
    <slot />
    <script src="/js/scroll-reveal.js" defer></script>
  </body>
</html>
