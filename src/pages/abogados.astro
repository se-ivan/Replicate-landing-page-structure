---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../app/components/abogados/App.tsx";
import { getArticlesForExactAudience } from "../lib/articles";

export const prerender = false;

const articles = await getArticlesForExactAudience("legal");
---

<BaseLayout 
  title="Espinoza Mosqueda Abogadas" 
  description="Defensa jurídica en Plenitud Emocional. Espinoza Mosqueda Abogadas, enfocadas en proteger los derechos de la edad de oro."
  keywords="plenitud emocional, plenitudemocional, abogados edad de oro, espinoza mosqueda abogadas, proteccion jurigica"
>
  <App articles={articles} client:load />
</BaseLayout>
