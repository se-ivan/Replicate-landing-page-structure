---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../app/components/abogados/App.tsx";
import { getArticlesForExactAudience } from "../lib/articles";

export const prerender = false;

const articles = await getArticlesForExactAudience("legal");
---

<BaseLayout 
  title="Acompañamiento y Defensa Legal para Adultos Mayores" 
  description="Defensa jurídica y asesoría en Plenitud Emocional. Espinoza Mosqueda Abogadas, especialistas en proteger los derechos patrimoniales y de la vejez."
  keywords="acompañamiento legal adultos mayores, defensa derechos adultos mayores, testamentos morelia, abogados adultos mayores, proteccion juridica edad de oro, plenitud emocional"
  image="/images/hero/hero-abogados.jpg"
>
  <App articles={articles} client:load />
</BaseLayout>
