---
import { filterArticlesByExactAudience, getArticles } from "../../lib/articles";
import type { Article, ArticleAudience } from "../../data/articles";
import { Navbar } from "../../app/components/Navbar";
import { Footer } from "../../app/components/Footer";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const getReadingTime = (text: string) => {
  const words = text.trim().split(/\s+/).length;
  return Math.max(3, Math.round(words / 180));
};

const getArticleReadingTime = (article: Article) => {
  const fullText = [
    article.intro,
    ...article.sections.flatMap((section) => [...section.paragraphs, ...(section.bullets ?? [])]),
  ].join(" ");
  return getReadingTime(fullText);
};

const requestedAudience = Astro.url.searchParams.get("categoria");
const selectedAudience = ["ambos", "psicologia", "legal"].includes(requestedAudience || "")
  ? requestedAudience as ArticleAudience
  : null;
const allArticles = await getArticles();
const articles = selectedAudience
  ? filterArticlesByExactAudience(allArticles, selectedAudience)
  : allArticles;

const audienceTabs: Array<{ label: string; href: string; active: boolean }> = [
  { label: "Todos", href: "/articulos", active: !selectedAudience },
  { label: "Inicio", href: "/articulos?categoria=ambos", active: selectedAudience === "ambos" },
  { label: "Psicologia", href: "/articulos?categoria=psicologia", active: selectedAudience === "psicologia" },
  { label: "Abogados", href: "/articulos?categoria=legal", active: selectedAudience === "legal" },
];

const audienceLabel = (audience: ArticleAudience) => {
  if (audience === "legal") return "Abogados";
  if (audience === "psicologia") return "Psicologia";
  return "Inicio";
};
---

<BaseLayout
  title="ArtÃ­culos sobre JubilaciÃ³n, Bienestar y Envejecimiento Activo"
  description="Explora artÃ­culos de Plenitud Emocional sobre jubilaciÃ³n, salud mental, envejecimiento activo, prevenciÃ³n y apoyo a cuidadores."
  image="/images/hero/hero-bg.jpg"
  bodyClass="bg-[#f5f2ec] text-[#1a2e1a]"
>
  <Navbar sectionPrefix="/" client:load />

    <header class="relative overflow-hidden text-white">
      <img src="/images/hero/hero-bg.jpg" alt="Fondo" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0f1a0fcc]/70 via-[#132214]/75 to-[#1a2e1a]/95"></div>
      <div class="relative mx-auto max-w-[1220px] px-6 md:px-12 lg:px-20 pt-24 pb-16 md:pt-32 md:pb-24">
        <a href="/" class="font-['Inter'] text-sm opacity-90 hover:opacity-100">Volver al inicio</a>
        <h1 class="mt-5 font-['Playfair_Display'] text-4xl md:text-6xl leading-[1.05]">Biblioteca de ArtÃ­culos</h1>
        <p class="mt-5 max-w-3xl font-['Inter'] text-base md:text-lg text-white/90 leading-relaxed">
          Lecturas para transitar esta etapa con claridad: emociones, envejecimiento activo, prevenciÃ³n y apoyo familiar.
        </p>
      </div>
    </header>

    <main class="mx-auto max-w-[1220px] px-6 md:px-12 lg:px-20 py-12 md:py-20">
      <div class="mb-8 flex flex-wrap gap-2">
        {
          audienceTabs.map((tab) => (
            <a
              href={tab.href}
              class={`rounded-full px-4 py-2 font-['Inter'] text-sm transition ${tab.active ? "bg-[#1a2e1a] text-white" : "bg-white text-[#1a2e1a] ring-1 ring-black/10 hover:ring-[#1a2e1a]/30"}`}
