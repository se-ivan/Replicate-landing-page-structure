              {tab.label}
            </a>
          ))
        }
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-7 md:gap-9">
        {
          articles.map((article) => (
            <article class="group h-full overflow-hidden rounded-3xl bg-white/95 shadow-sm ring-1 ring-black/10 transition duration-300 hover:shadow-xl hover:-translate-y-1">
              <div class="relative h-60 md:h-72 overflow-hidden">
                <img
                  src={article.img}
                  alt={article.title}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent"></div>
              </div>
              <div class="p-6 md:p-7 flex flex-col">
                <div class="flex items-center justify-between gap-3 font-['Inter'] text-xs text-[#1a2e1a]/60">
                  <span>{getArticleReadingTime(article)} min de lectura</span>
                  <span>{audienceLabel(article.audience)}</span>
                </div>
                <h2 class="mt-3 font-['Playfair_Display'] text-3xl leading-tight text-[#1a2e1a]">{article.title}</h2>
                <p class="mt-3 font-['Inter'] text-[15px] md:text-base text-[#1a2e1a]/82 leading-relaxed">{article.desc}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {article.tags.map((tag) => <span class="rounded-full bg-[#edf1e8] px-3 py-1 font-['Inter'] text-xs text-[#1a2e1a]">{tag}</span>)}
                </div>
                <a
                  href={`/articulos/${article.id}`}
                  class="mt-7 inline-flex w-fit items-center rounded-full bg-[#1a2e1a] px-5 py-2.5 font-['Inter'] text-sm text-white transition hover:bg-[#2c462c]"
                >
                  Leer artÃ­culo
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </main>

  <Footer sectionPrefix="/" />
</BaseLayout>
