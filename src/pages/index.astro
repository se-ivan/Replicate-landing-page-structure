---
import App from "../app/App";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getArticlesForExactAudience } from "../lib/articles";

export const prerender = false;

const articles = (await getArticlesForExactAudience("ambos")).slice(0, 4);
---

<BaseLayout
  title="Acompañamiento Psicológico y Orientación Legal para Adultos Mayores"
  description="Plenitud Emocional brinda acompañamiento psicológico y orientación legal especializada para personas adultas mayores y sus familias en Morelia, Michoacán."
  keywords="plenitud emocional, acompañamiento legal o psicologico para adultos mayores, psicologos adultos mayores morelia, abogados adultos mayores, plenitudemocional.com, acompañamiento emocional, jubilacion activa"
  image="/images/hero/hero-bg.jpg"
>
  <App articles={articles} client:load />
</BaseLayout>
