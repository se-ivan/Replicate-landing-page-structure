---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../app/components/psicologia/App.tsx";
import { getArticlesForExactAudience } from "../lib/articles";

export const prerender = false;

const articles = await getArticlesForExactAudience("psicologia");
---

<BaseLayout 
  title="Acompañamiento Psicológico y Bienestar Emocional" 
  description="Servicios de psicología clínica y acompañamiento emocional para adultos mayores y familias en Morelia con Plenitud Emocional."
  keywords="acompañamiento psicologico adultos mayores, plenitud emocional, terapia psicologica adultos mayores, terapia individual, psicologos morelia, salud mental vejez, bienestar emocional"
>
  <App articles={articles} client:load />
</BaseLayout>
