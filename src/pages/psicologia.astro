---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../app/components/psicologia/App.tsx";
import { getArticlesForExactAudience } from "../lib/articles";

export const prerender = false;

const articles = await getArticlesForExactAudience("psicologia");
---

<BaseLayout 
  title="Psicología" 
  description="Servicios de Psicología Clínica en Plenitud Emocional. Ofrecemos terapia individual y grupal para conectar contigo."
  keywords="plenitud emocional, plenitudemocional, psicologia clinica, catalina gallegos psicologa, terapia individual"
>
  <App articles={articles} client:load />
</BaseLayout>
