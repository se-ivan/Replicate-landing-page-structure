---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../app/components/psicologia/App.tsx";
import { getArticlesForExactAudience } from "../lib/articles";

export const prerender = false;

const articles = await getArticlesForExactAudience("psicologia");
---

<BaseLayout 
  title="Acompañamiento Psicológico y Psicoterapia para Adultos Mayores" 
  description="Servicios de Psicología Clínica y acompañamiento psicológico para adultos mayores. Terapia individual y grupal en Morelia con la Psic. Catalina Gallegos."
  keywords="acompañamiento psicologico para adultos mayores, plenitud emocional, terapia psicologica adultos mayores, psicologa catalina gallegos, terapia individual, psicologos morelia, salud mental vejez"
>
  <App articles={articles} client:load />
</BaseLayout>
